{
  "name": "multicam",
  "private": true,
  "workspaces": [
    "packages/shared",
    "server",
    "web",
    "mobile"
  ],
  "engines": {
    "node": ">=24.3.0"
  },
  "scripts": {
    "dev:server": "npm run dev -w @multicam/server",
    "dev:web": "npm run dev -w @multicam/web",
    "dev:mobile": "npm run start -w @multicam/mobile",
    "build:web": "npm run build -w @multicam/web",
    "start": "npm run build:web && npm run start -w @multicam/server",
    "test": "npm test -w @multicam/server && npm test -w @multicam/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "controller:password": "npm run controller:password -w @multicam/server",
    "demo": "node scripts/demo.mjs",
    "demo:4g": "node scripts/demo.mjs --tunnel",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "description": "Điều khiển nhiều điện thoại cùng quay video, bài tập lớn IT4409",
  "devDependencies": {
    "prettier": "^3.10.1"
  }
}
