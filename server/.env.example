# Cổng và địa chỉ lắng nghe
PORT=3000
HOST=0.0.0.0
# Nơi lưu CSDL SQLite và file video
DATA_DIR=./data
# Tài khoản Controller duy nhất do nhà phát hành cấp sẵn (tạo khi server khởi động lần đầu)
CONTROLLER_EMAIL=controller@multicam.local
CONTROLLER_PHONE=0900000000
CONTROLLER_PASSWORD=Controller123
CONTROLLER_FIRST_NAME=Multicam
CONTROLLER_LAST_NAME=Controller
# Slide yêu cầu get_verify_code trả luôn mã để đơn giản. Đặt false khi đã có dịch vụ email/SMS.
RETURN_VERIFY_CODE=true
# Origin được phép gọi API từ trình duyệt (để trống = cho phép tất cả)
CORS_ORIGIN=
# ffmpeg để remux video sang MP4 chuẩn + tạo ảnh thu nhỏ (không bắt buộc). "none" = tắt.
# Windows: winget install Gyan.FFmpeg
FFMPEG_PATH=ffmpeg
